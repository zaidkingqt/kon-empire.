<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630" fill="none">
  <rect width="1200" height="630" fill="#0a0d12"/>
  <circle cx="1000" cy="150" r="300" fill="#10b981" fill-opacity="0.08" filter="blur(80px)"/>
  <circle cx="200" cy="500" r="250" fill="#06b6d4" fill-opacity="0.06" filter="blur(80px)"/>
  
  <!-- Outer border -->
  <rect x="20" y="20" width="1160" height="590" rx="24" stroke="#1f2937" stroke-width="2"/>
  
  <!-- Logo Icon -->
  <g transform="translate(80, 100)">
    <rect width="72" height="72" rx="18" fill="#10b981"/>
    <path d="M36 14L14 54h44L36 14zm0 9.5l13.5 23.5H22.5L36 23.5z" fill="#052e16"/>
    <circle cx="36" cy="41" r="5" fill="#ffffff"/>
  </g>
  
  <text x="170" y="150" fill="#f3f4f6" font-family="Inter, system-ui, sans-serif" font-size="38" font-weight="800" letter-spacing="-1">VectorForge</text>
  <rect x="420" y="122" width="60" height="28" rx="6" fill="#10b981" fill-opacity="0.15" stroke="#10b981" stroke-opacity="0.3"/>
  <text x="432" y="141" fill="#34d399" font-family="monospace" font-size="14" font-weight="700">MVP</text>
  
  <!-- Main Title -->
  <text x="80" y="270" fill="#ffffff" font-family="Inter, system-ui, sans-serif" font-size="56" font-weight="900" letter-spacing="-1.5">
    Convert, Optimize &amp; Export
  </text>
  <text x="80" y="340" fill="#34d399" font-family="Inter, system-ui, sans-serif" font-size="56" font-weight="900" letter-spacing="-1.5">
    SVGs Instantly
  </text>
  
  <text x="80" y="410" fill="#9ca3af" font-family="Inter, system-ui, sans-serif" font-size="22" font-weight="400">
    Fast, privacy-first SVG toolkit for developers &amp; designers. 100% client-side in your browser.
  </text>
  
  <!-- Feature Badges -->
  <g transform="translate(80, 480)">
    <rect width="130" height="42" rx="10" fill="#11161f" stroke="#1f2937"/>
    <text x="20" y="26" fill="#f3f4f6" font-family="Inter, sans-serif" font-size="15" font-weight="600">⚡ SVGO</text>
    
    <rect x="145" width="130" height="42" rx="10" fill="#11161f" stroke="#1f2937"/>
    <text x="165" y="26" fill="#f3f4f6" font-family="Inter, sans-serif" font-size="15" font-weight="600">⚛️ React</text>
    
    <rect x="290" width="130" height="42" rx="10" fill="#11161f" stroke="#1f2937"/>
    <text x="310" y="26" fill="#f3f4f6" font-family="Inter, sans-serif" font-size="15" font-weight="600">💙 Flutter</text>
    
    <rect x="435" width="130" height="42" rx="10" fill="#11161f" stroke="#1f2937"/>
    <text x="455" y="26" fill="#f3f4f6" font-family="Inter, sans-serif" font-size="15" font-weight="600">🍎 SwiftUI</text>
    
    <rect x="580" width="150" height="42" rx="10" fill="#11161f" stroke="#1f2937"/>
    <text x="598" y="26" fill="#f3f4f6" font-family="Inter, sans-serif" font-size="15" font-weight="600">🤖 Android XML</text>
    
    <rect x="745" width="130" height="42" rx="10" fill="#11161f" stroke="#1f2937"/>
    <text x="765" y="26" fill="#f3f4f6" font-family="Inter, sans-serif" font-size="15" font-weight="600">🖼️ PNG / WebP</text>
  </g>
  
  <text x="1030" y="560" fill="#6b7280" font-family="monospace" font-size="16">vectorforge.dev</text>
</svg>