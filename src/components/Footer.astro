---
const tools = [
  { name: 'SVG Optimizer', href: '/svg-optimizer' },
  { name: 'SVG to React JSX', href: '/svg-to-react' },
  { name: 'SVG to Flutter', href: '/svg-to-flutter' },
  { name: 'SVG to SwiftUI', href: '/svg-to-swiftui' },
  { name: 'SVG to Android Vector', href: '/svg-to-android-vector' },
  { name: 'SVG to PNG', href: '/svg-to-png' },
  { name: 'SVG to WebP', href: '/svg-to-webp' },
];
---

<footer class="w-full border-t border-forge-border bg-forge-surface/60 mt-16 text-xs text-forge-textMuted">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand & Privacy Guarantee -->
      <div class="md:col-span-2 flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded bg-brand-500 flex items-center justify-center text-black font-black text-xs">
            VF
          </div>
          <span class="font-bold text-sm text-forge-text">VectorForge</span>
        </div>
        <p class="text-xs text-forge-textMuted max-w-sm leading-relaxed">
          High-performance, client-side SVG engineering tools for frontend developers, mobile engineers, and UI designers.
        </p>
        <div class="p-3 rounded-lg bg-forge-surface border border-forge-border/80 flex items-center gap-2.5 max-w-sm">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          <span class="text-[11px] text-forge-text">
            <strong>Privacy Promise:</strong> All vector operations execute locally inside your browser. No files are uploaded to our servers.
          </span>
        </div>
      </div>

      <!-- Col 2: Core Tools -->
      <div class="flex flex-col gap-2.5">
        <span class="font-semibold text-forge-text uppercase tracking-wider text-[11px]">
          Vector Tools
        </span>
        <ul class="flex flex-col gap-2">
          {tools.map((t) => (
            <li>
              <a href={t.href} class="hover:text-brand-400 transition-colors">
                {t.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Resources & Open Source -->
      <div class="flex flex-col gap-2.5">
        <span class="font-semibold text-forge-text uppercase tracking-wider text-[11px]">
          Resources
        </span>
        <ul class="flex flex-col gap-2">
          <li>
            <a href="/docs" class="hover:text-brand-400 transition-colors">Documentation</a>
          </li>
          <li>
            <a href="/#workspace" class="hover:text-brand-400 transition-colors">Interactive Studio</a>
          </li>
          <li>
            <a href="https://github.com/zaidkingqt/kon-empire." target="_blank" rel="noopener noreferrer" class="hover:text-brand-400 transition-colors">
              GitHub Repository
            </a>
          </li>
          <li>
            <a href="/sitemap-index.xml" class="hover:text-brand-400 transition-colors">Sitemap</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-8 pt-6 border-t border-forge-border/50 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
      <span>© {new Date().getFullYear()} VectorForge. Free & Open-Web Tool.</span>
      <div class="flex items-center gap-4">
        <span>Static Edge Powered</span>
        <span>•</span>
        <span>0ms Server Latency</span>
        <span>•</span>
        <span>Zero Data Collection</span>
      </div>
    </div>
  </div>
</footer>
