---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs: FaqItem[];
}

const { title = 'Frequently Asked Questions', faqs } = Astro.props;

// Schema.org FAQPage structured data
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section class="w-full max-w-4xl mx-auto my-12 px-4 sm:px-6">
  <div class="text-center mb-8">
    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-forge-text">
      {title}
    </h2>
    <p class="text-xs sm:text-sm text-forge-textMuted mt-1">
      Everything you need to know about SVG optimization, conversion, and privacy.
    </p>
  </div>

  <div class="flex flex-col gap-3">
    {faqs.map((faq, index) => (
      <details class="group rounded-xl bg-forge-surface border border-forge-border p-4 transition-all duration-150 open:border-brand-500/40">
        <summary class="flex items-center justify-between font-medium text-sm text-forge-text cursor-pointer select-none">
          <span>{faq.question}</span>
          <span class="ml-2 text-forge-textMuted group-open:rotate-180 transition-transform duration-200">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <p class="text-xs sm:text-sm text-forge-textMuted mt-3 leading-relaxed border-t border-forge-border/40 pt-3">
          {faq.answer}
        </p>
      </details>
    ))}
  </div>

  <!-- Inject Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
