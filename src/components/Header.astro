---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const tools = [
  { name: 'SVG Optimizer', href: '/svg-optimizer', desc: 'Minify & clean SVG markup' },
  { name: 'SVG → React JSX', href: '/svg-to-react', desc: 'Generate React / TSX components' },
  { name: 'SVG → Flutter', href: '/svg-to-flutter', desc: 'CustomPainter & SvgPicture widgets' },
  { name: 'SVG → SwiftUI', href: '/svg-to-swiftui', desc: 'SwiftUI Shapes & Vector views' },
  { name: 'SVG → Android XML', href: '/svg-to-android-vector', desc: 'Android VectorDrawable XML' },
  { name: 'SVG → PNG', href: '/svg-to-png', desc: 'High-res rasterizer (1x-8x, 4K)' },
  { name: 'SVG → WebP', href: '/svg-to-webp', desc: 'Compressed modern web format' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-forge-border bg-forge-bg/85 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-black font-black shadow-md shadow-emerald-500/20 group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4 text-black" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L2 19.5h20L12 2zm0 4.2l6.8 11.8H5.2L12 6.2z"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-base sm:text-lg tracking-tight text-forge-text flex items-center gap-1.5">
          VectorForge
          <span class="text-[10px] uppercase font-mono px-1.5 py-0.2 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            MVP
          </span>
        </span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <!-- Tools Dropdown -->
      <div class="relative group">
        <button type="button" class="flex items-center gap-1.5 text-forge-textMuted hover:text-forge-text py-2 transition-colors cursor-pointer">
          <span>All Tools</span>
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-150 w-72">
          <div class="p-2 rounded-xl bg-forge-surface border border-forge-border shadow-2xl flex flex-col gap-1">
            {tools.map((t) => (
              <a
                href={t.href}
                class="p-2.5 rounded-lg hover:bg-forge-surfaceHover transition-colors flex flex-col group/item"
              >
                <span class="text-xs font-semibold text-forge-text group-hover/item:text-brand-400">
                  {t.name}
                </span>
                <span class="text-[11px] text-forge-textMuted">
                  {t.desc}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href="/docs"
        class={`transition-colors hover:text-forge-text ${
          currentPath === '/docs' ? 'text-brand-400' : 'text-forge-textMuted'
        }`}
      >
        Documentation
      </a>

      <a
        href="https://github.com/zaidkingqt/kon-empire."
        target="_blank"
        rel="noopener noreferrer"
        class="text-forge-textMuted hover:text-forge-text transition-colors flex items-center gap-1.5"
      >
        <span>GitHub</span>
        <svg class="w-3.5 h-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-3">
      <a
        href="/#workspace"
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-brand-500 hover:bg-brand-400 text-black text-xs font-semibold transition-colors shadow-sm"
      >
        <span>Open Studio</span>
      </a>

      <!-- Dark/Light Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="p-2 rounded-lg border border-forge-border bg-forge-surface text-forge-textMuted hover:text-forge-text hover:bg-forge-surfaceHover transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('theme-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }
</script>
