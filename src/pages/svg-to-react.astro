---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Workspace } from '../components/Workspace';
import { AdContainer } from '../components/AdContainer';
import FaqSection from '../components/FaqSection.astro';

const faqs = [
  {
    question: 'How does VectorForge handle SVG attributes that conflict with JSX?',
    answer: 'VectorForge automatically converts standard hyphenated SVG attributes (e.g. stroke-width, fill-rule, clip-path) to their React camelCase equivalents (strokeWidth, fillRule, clipPath), transforms class to className, and parses inline style strings into React style objects.',
  },
  {
    question: 'Does the generated component support TypeScript and forwardRef?',
    answer: 'Yes. You can toggle TypeScript (.tsx) mode to generate strongly typed components extending React.SVGProps<SVGSVGElement>. You can also enable forwardRef for seamless integration with animation libraries like Framer Motion or UI positioning libraries.',
  },
  {
    question: 'Can I export components for React Native?',
    answer: 'Yes. Enabling the React Native option imports and formats primitives from the popular react-native-svg package (Svg, Path, Rect, Circle, G), making them ready for mobile apps.',
  },
  {
    question: 'Why should I use inline React SVG components instead of img src?',
    answer: 'Inline SVG components allow you to dynamically change fill, stroke, size, and hover states using standard React props and Tailwind CSS classes, while avoiding additional HTTP network requests.',
  },
];
---

<BaseLayout
  title="SVG to React JSX / TypeScript Converter Online | VectorForge"
  description="Convert SVG code into clean, production-ready React JSX or TypeScript (.tsx) components instantly. Supports forwardRef, spread props, and camelCased attributes."
  canonicalPath="/svg-to-react"
  keywords={['svg to react', 'svg to jsx', 'svg to tsx', 'svgr online', 'react svg component generator', 'svg to react native']}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-4 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-medium mb-4">
      <span class="flex h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
      React 19 & TypeScript • forwardRef • Clean JSX
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-forge-text">
      SVG to React & JSX Component Generator
    </h1>
    <p class="mt-3 text-sm sm:text-base text-forge-textMuted max-w-2xl mx-auto leading-relaxed">
      Convert raw SVG markup into production-ready React JSX, TypeScript (.tsx), or React Native components with auto camelCasing and props forwarding.
    </p>
  </div>

  <AdContainer slot="top-leaderboard" client:load />

  <section class="w-full">
    <Workspace client:load initialTool="react" />
  </section>

  <AdContainer slot="in-content" client:load />

  <!-- Educational Guide -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 my-16 prose prose-invert">
    <div class="p-8 rounded-2xl bg-forge-surface border border-forge-border">
      <h2 class="text-xl sm:text-2xl font-bold text-forge-text mb-4">
        Best Practices for Using SVGs in Modern React Applications
      </h2>
      <p class="text-xs sm:text-sm text-forge-textMuted leading-relaxed mb-6">
        Pasting raw SVG markup directly into React JSX files causes syntax errors because HTML/XML attributes use kebab-case (e.g. <code>stroke-width="2"</code>) while React requires camelCase properties (e.g. <code>strokeWidth={2}</code>).
      </p>

      <div class="p-4 rounded-xl bg-black/40 border border-forge-border text-xs font-mono text-forge-text mb-6 overflow-x-auto">
        <div class="text-forge-textMuted mb-2">// Example generated TypeScript React Component</div>
        <pre class="text-emerald-400"><code>{`export const CustomIcon = React.forwardRef<SVGSVGElement, CustomIconProps>(
  ({ size = 24, width, height, ...props }, ref) => (
    <svg
      ref={ref}
      width={width || size}
      height={height || size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth={2}
      {...props}
    >
      <path d="..." />
    </svg>
  )
);`}</code></pre>
      </div>

      <h3 class="text-base sm:text-lg font-bold text-forge-text mb-2">
        Why Developers Choose VectorForge over Manual Conversion:
      </h3>
      <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-forge-textMuted">
        <li><strong>Automated CamelCasing:</strong> Replaces over 40+ SVG-specific attributes into React-compliant props.</li>
        <li><strong>Inline Style Transformation:</strong> Converts CSS strings (e.g. <code>style="fill: red;"</code>) into React objects (<code>style={`{{ fill: 'red' }}`}</code>).</li>
        <li><strong>Framer Motion & Ref Support:</strong> Integrates <code>forwardRef</code> so you can attach refs for tooltips, modals, and spring physics.</li>
      </ul>
    </div>
  </article>

  <FaqSection faqs={faqs} />
</BaseLayout>
