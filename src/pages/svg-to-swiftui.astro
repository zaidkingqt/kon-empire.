---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Workspace } from '../components/Workspace';
import { AdContainer } from '../components/AdContainer';
import FaqSection from '../components/FaqSection.astro';

const faqs = [
  {
    question: 'How do I use the generated SwiftUI code in Xcode?',
    answer: 'Simply copy the generated Swift struct and paste it into a new Swift file in your Xcode project (e.g. CustomIcon.swift). You can then use it anywhere in your SwiftUI hierarchy: CustomIcon(size: 24, color: .accentColor).',
  },
  {
    question: 'Does VectorForge support dark mode dynamic colors in SwiftUI?',
    answer: 'Yes. By accepting optional SwiftUI Color parameters and utilizing GraphicsContext, the generated views automatically adapt to iOS and macOS system light/dark appearance.',
  },
  {
    question: 'What versions of iOS and macOS are supported?',
    answer: 'The generated SwiftUI code targets iOS 15+, iPadOS 15+, and macOS 12+ (Monterey and newer).',
  },
];
---

<BaseLayout
  title="SVG to SwiftUI Shape & Vector Converter Online | VectorForge"
  description="Convert SVG paths and shapes into native SwiftUI View structs and Shape paths for iOS, iPadOS, and macOS apps. 100% private."
  canonicalPath="/svg-to-swiftui"
  keywords={['svg to swiftui', 'swiftui svg converter', 'svg to swift', 'swiftui shape from svg', 'ios vector converter']}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-4 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-400 text-xs font-medium mb-4">
      <span class="flex h-1.5 w-1.5 rounded-full bg-violet-400 animate-pulse"></span>
      Swift 5 / 6 • SwiftUI 4+ • iOS & macOS Native
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-forge-text">
      SVG to SwiftUI Code Generator
    </h1>
    <p class="mt-3 text-sm sm:text-base text-forge-textMuted max-w-2xl mx-auto leading-relaxed">
      Convert vector graphics and SVG paths into native, scalable SwiftUI Shapes and Views with dynamic color tinting.
    </p>
  </div>

  <AdContainer slot="top-leaderboard" client:load />

  <section class="w-full">
    <Workspace client:load initialTool="swiftui" />
  </section>

  <AdContainer slot="in-content" client:load />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 my-16 prose prose-invert">
    <div class="p-8 rounded-2xl bg-forge-surface border border-forge-border">
      <h2 class="text-xl sm:text-2xl font-bold text-forge-text mb-4">
        Native Vector Graphics in Apple Platforms
      </h2>
      <p class="text-xs sm:text-sm text-forge-textMuted leading-relaxed mb-4">
        Instead of managing multi-scale raster PNG assets (@1x, @2x, @3x) in asset catalogs, converting your vectors directly to SwiftUI code ensures crisp rendering on all Retina screens (from Apple Watch to 5K Studio Display) with zero asset bloat.
      </p>
    </div>
  </article>

  <FaqSection faqs={faqs} />
</BaseLayout>
