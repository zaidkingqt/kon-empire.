---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Workspace } from '../components/Workspace';
import { AdContainer } from '../components/AdContainer';
import FaqSection from '../components/FaqSection.astro';

const faqs = [
  {
    question: 'How much file size reduction can I expect from SVG Optimizer?',
    answer: 'Typical SVG files exported directly from design tools like Figma, Adobe Illustrator, or Sketch contain 30% to 75% redundant metadata, comments, and unrounded coordinate decimals. Optimizing them with VectorForge usually shrinks the file by 40% to 70% with zero visual loss.',
  },
  {
    question: 'Does this optimizer run on your servers or in my browser?',
    answer: '100% inside your browser. VectorForge runs a bundled, Web-compatible SVGO engine in local JavaScript. Your vector files are never transmitted across the network.',
  },
  {
    question: 'What is the precision slider and how does it work?',
    answer: 'The precision slider configures decimal truncation for coordinate values in path data. For example, a coordinate like 12.489124 can be rounded to 12.49 (2 decimals), saving multiple bytes per point while keeping the visual curve indistinguishable.',
  },
  {
    question: 'Can SVGO break complex SVG animations or masks?',
    answer: 'By default, VectorForge uses safe optimization presets that preserve IDs, masks, and CSS classes required for styling and animations. You can toggle individual optimization flags in the options toolbar.',
  },
];
---

<BaseLayout
  title="SVG Optimizer — Minify & Clean SVG Files Online | VectorForge"
  description="Free browser-based SVG optimizer powered by SVGO. Compress vector graphics, strip bloated editor metadata, and minify SVG code locally without server uploads."
  canonicalPath="/svg-optimizer"
  keywords={['svg optimizer', 'svgo online', 'compress svg', 'minify svg', 'clean svg file', 'reduce svg size']}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-4 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium mb-4">
      <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      SVGO Engine • 100% Client-Side • Lossless Compression
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-forge-text">
      Free Online SVG Optimizer & Minifier
    </h1>
    <p class="mt-3 text-sm sm:text-base text-forge-textMuted max-w-2xl mx-auto leading-relaxed">
      Strip editor metadata, round coordinate decimals, collapse empty groups, and reduce SVG file size by up to 70% directly in your browser.
    </p>
  </div>

  <AdContainer slot="top-leaderboard" client:load />

  <section class="w-full">
    <Workspace client:load initialTool="optimize" />
  </section>

  <AdContainer slot="in-content" client:load />

  <!-- Educational & Technical Guide Section -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 my-16 prose prose-invert">
    <div class="p-8 rounded-2xl bg-forge-surface border border-forge-border">
      <h2 class="text-xl sm:text-2xl font-bold text-forge-text mb-4">
        Why Optimizing SVGs Matters for Web Performance
      </h2>
      <p class="text-xs sm:text-sm text-forge-textMuted leading-relaxed mb-6">
        Modern UI design applications (Figma, Sketch, Adobe Illustrator, and Inkscape) prioritize editor convenience over production web efficiency. When you export an icon or illustration, the resulting SVG markup contains extraneous XML namespaces, doctype tags, editor layer names, and 8-digit floating-point coordinates.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 text-xs">
        <div class="p-4 rounded-xl bg-black/40 border border-rose-500/30">
          <div class="font-bold text-rose-400 mb-2">❌ Unoptimized Raw Export (~18.4 KB)</div>
          <ul class="list-disc list-inside space-y-1 text-forge-textMuted">
            <li>Heavy XML doctype & comments</li>
            <li>Sodipodi & Inkscape namespaces</li>
            <li>Nested empty container &lt;g&gt; tags</li>
            <li>8-decimal float coordinates (e.g. 14.2819274)</li>
          </ul>
        </div>

        <div class="p-4 rounded-xl bg-black/40 border border-emerald-500/30">
          <div class="font-bold text-emerald-400 mb-2">✅ VectorForge Optimized (~5.8 KB)</div>
          <ul class="list-disc list-inside space-y-1 text-forge-textMuted">
            <li>Pure, clean SVG markup</li>
            <li>Zero editor metadata or unused IDs</li>
            <li>Collapsed groups & minified paths</li>
            <li>Clean 2-decimal rounded precision</li>
          </ul>
        </div>
      </div>

      <h3 class="text-base sm:text-lg font-bold text-forge-text mb-2">
        Key Optimization Operations Handled by VectorForge:
      </h3>
      <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-forge-textMuted">
        <li><strong>Metadata Stripping:</strong> Removes &lt;metadata&gt;, &lt;title&gt;, and &lt;desc&gt; tags left by design tools.</li>
        <li><strong>Path Simplification:</strong> Merges redundant path commands and converts bezier curves into compact syntax.</li>
        <li><strong>Color Conversion:</strong> Shortens color declarations (e.g. #ffffff to #fff or rgb(255,0,0) to red).</li>
        <li><strong>Decimal Precision Truncation:</strong> Rounds excessive decimals to reduce raw character count.</li>
      </ul>
    </div>
  </article>

  <FaqSection faqs={faqs} />
</BaseLayout>
