---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Workspace } from '../components/Workspace';
import { AdContainer } from '../components/AdContainer';
import FaqSection from '../components/FaqSection.astro';

const faqs = [
  {
    question: 'How are PNG images rendered without uploading the SVG to a server?',
    answer: 'VectorForge uses the browser HTML5 Canvas API and OffscreenCanvas. The SVG markup is converted into a local Blob URL, loaded into an in-memory Image object, drawn to the canvas at your desired scale, and exported as a PNG data blob directly to your downloads.',
  },
  {
    question: 'Can I export Retina 2x, 4x, or 8K resolution PNGs?',
    answer: 'Yes! VectorForge lets you choose scale presets (1x, 2x, 3x, 4x, 8x) or type custom pixel dimensions. Because SVG is mathematically scalable, your exported PNG remains razor sharp at any resolution.',
  },
  {
    question: 'Does the PNG export preserve transparency?',
    answer: 'Yes. By default, transparent SVG backgrounds remain 100% transparent in the exported PNG. You can also pick a solid background color (e.g. white, black, or custom hex) if desired.',
  },
];
---

<BaseLayout
  title="SVG to PNG Converter — 100% Client-Side High-Res Rasterizer | VectorForge"
  description="Convert SVG vector files to crystal clear PNG images at 1x, 2x Retina, 4x, or custom resolutions directly in your browser. 100% private."
  canonicalPath="/svg-to-png"
  keywords={['svg to png', 'convert svg to png online', 'high res svg to png', 'retina png from svg', 'transparent svg to png']}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-4 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-medium mb-4">
      <span class="flex h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
      1x to 8x Ultra HD • Canvas Rasterizer • Transparent Alpha
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-forge-text">
      SVG to High-Resolution PNG Converter
    </h1>
    <p class="mt-3 text-sm sm:text-base text-forge-textMuted max-w-2xl mx-auto leading-relaxed">
      Convert vector SVG graphics into lossless, transparent PNG bitmaps at up to 8K resolution without sending files to any server.
    </p>
  </div>

  <AdContainer slot="top-leaderboard" client:load />

  <section class="w-full">
    <Workspace client:load initialTool="png" />
  </section>

  <AdContainer slot="in-content" client:load />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 my-16 prose prose-invert">
    <div class="p-8 rounded-2xl bg-forge-surface border border-forge-border">
      <h2 class="text-xl sm:text-2xl font-bold text-forge-text mb-4">
        Lossless Vector Rasterization Directly in the Browser
      </h2>
      <p class="text-xs sm:text-sm text-forge-textMuted leading-relaxed mb-4">
        Unlike traditional online image converters that queue your files on remote Linux servers and charge subscription fees, VectorForge renders vectors locally via hardware-accelerated 2D canvas contexts.
      </p>
    </div>
  </article>

  <FaqSection faqs={faqs} />
</BaseLayout>
