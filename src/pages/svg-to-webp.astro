---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Workspace } from '../components/Workspace';
import { AdContainer } from '../components/AdContainer';
import FaqSection from '../components/FaqSection.astro';

const faqs = [
  {
    question: 'Why convert SVG to WebP instead of PNG?',
    answer: 'WebP provides superior compression efficiency compared to PNG (typically 25% to 35% smaller file sizes) while preserving full alpha-channel transparency and crisp edges, making it ideal for web page hero illustrations and thumbnail fallbacks.',
  },
  {
    question: 'Can I adjust the WebP compression quality?',
    answer: 'Yes. VectorForge includes a quality slider allowing you to choose between 10% and 100% lossy/lossless WebP compression, with real-time file size previews.',
  },
];
---

<BaseLayout
  title="SVG to WebP Converter — Client-Side Modern Image Exporter | VectorForge"
  description="Convert SVG graphics to lightweight WebP images with custom compression and resolution controls directly inside your browser."
  canonicalPath="/svg-to-webp"
  keywords={['svg to webp', 'convert svg to webp online', 'compressed webp from svg', 'webp vector converter']}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-4 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-medium mb-4">
      <span class="flex h-1.5 w-1.5 rounded-full bg-teal-400 animate-pulse"></span>
      Modern Web Format • Quality Control • Ultra Lightweight
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-forge-text">
      SVG to WebP Modern Image Converter
    </h1>
    <p class="mt-3 text-sm sm:text-base text-forge-textMuted max-w-2xl mx-auto leading-relaxed">
      Convert SVG graphics into high-efficiency WebP bitmaps with configurable compression quality and multi-scale resolution presets.
    </p>
  </div>

  <AdContainer slot="top-leaderboard" client:load />

  <section class="w-full">
    <Workspace client:load initialTool="webp" />
  </section>

  <AdContainer slot="in-content" client:load />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 my-16 prose prose-invert">
    <div class="p-8 rounded-2xl bg-forge-surface border border-forge-border">
      <h2 class="text-xl sm:text-2xl font-bold text-forge-text mb-4">
        Optimizing Web Delivery with Next-Gen WebP Images
      </h2>
      <p class="text-xs sm:text-sm text-forge-textMuted leading-relaxed mb-4">
        WebP is supported by all modern browsers (Chrome, Safari, Firefox, Edge, iOS Safari, Android Chrome). Converting complex multi-layer SVGs (such as map diagrams or rich gradient artwork) into WebP often reduces memory usage on mobile devices while improving Google Core Web Vitals (LCP).
      </p>
    </div>
  </article>

  <FaqSection faqs={faqs} />
</BaseLayout>
